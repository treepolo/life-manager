{
  "name": "life-manager",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:ui": "vite",
    "build": "npm run typecheck && npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "preview": "vite preview",
    "deploy:staging": "npm run verify:staging-deploy && node scripts/run-wrangler-deploy.mjs --env staging",
    "deploy:production": "npm run verify && npm run check:production-deploy-ready && node scripts/run-wrangler-deploy.mjs --env production",
    "check:production-deploy-ready": "node scripts/check-production-deploy-ready.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.worker.json",
    "test": "vitest run -c vitest.config.ts",
    "test:watch": "vitest -c vitest.config.ts",
    "test:worker": "node scripts/run-worker-tests.mjs",
    "test:e2e": "node scripts/run-e2e.mjs",
    "model:taiwan": "node scripts/taiwan-distributions/build.mjs",
    "model:taiwan:check": "node scripts/taiwan-distributions/validate.mjs",
    "db:migrate": "wrangler d1 migrations apply LIFE_DB --local",
    "db:migrate:staging": "wrangler d1 migrations apply LIFE_DB --env staging --remote",
    "db:migrate:production": "wrangler d1 migrations apply LIFE_DB --env production --remote",
    "db:backup:local": "wrangler d1 export LIFE_DB --local --output backups/local.sql",
    "scan": "node scripts/scan-production-placeholders.mjs",
    "verify:requirements": "node scripts/verify-requirements.mjs",
    "verify:staging-deploy": "npm run lint && npm run typecheck && npm run model:taiwan:check && npm run test && npm run test:worker && npm run build:client && npm run scan && npm run verify:requirements",
    "verify": "npm run lint && npm run typecheck && npm run model:taiwan:check && npm run test && npm run test:worker && npm run build:client && npm run test:e2e && npm run scan && npm run verify:requirements"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "1.0.2",
    "@tanstack/react-query": "5.101.4",
    "decimal.js": "10.6.0",
    "idb": "8.0.3",
    "papaparse": "5.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "recharts": "3.10.1",
    "rrule": "2.8.1",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.2",
    "@cloudflare/vitest-pool-workers": "0.20.3",
    "@cloudflare/workers-types": "5.20260804.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.1.2",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "fake-indexeddb": "6.2.5",
    "globals": "17.8.0",
    "jsdom": "29.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.2",
    "typescript-eslint": "8.65.0",
    "vite": "7.3.6",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.10",
    "wrangler": "4.120.1"
  }
}
