{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "types": ["@cloudflare/workers-types", "@cloudflare/vitest-pool-workers/types", "vitest/globals"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src/worker", "src/service-worker", "src/core", "src/modules", "src/integrations", "tests/worker", "vitest.worker.config.ts"],
  "exclude": ["src/core/sync/client-db.ts", "src/core/sync/sync-manager.ts"]
}
